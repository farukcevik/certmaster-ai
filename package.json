{
  "name": "certmaster-ai",
  "version": "1.0.0",
  "packageManager": "pnpm@10.20.0",
  "private": true,
  "description": "Offline-first certification exam simulator",
  "author": "CertMaster AI",
  "main": "dist-electron/electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 dist-electron/electron/main/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build:mobile": "tsc -p tsconfig.mobile.json --noEmit && vite build --config vite.mobile.config.ts",
    "test:mobile": "vitest run --config vitest.mobile.config.ts",
    "ios:sync": "pnpm run build:mobile && cap sync ios",
    "ios:open": "cap open ios",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "pnpm rebuild better-sqlite3 && vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && pnpm run rebuild:electron && playwright test",
    "lint": "eslint . --max-warnings=0",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "seed:pde": "node dist-electron/electron/scripts/seedPdeFromJson.js question-banks/GCP_PDE_349_questions.json",
    "package": "npm run build && pnpm run rebuild:electron && electron-builder --config.npmRebuild=false",
    "package:mac": "pnpm run package:mac:arm64 && pnpm run package:mac:x64",
    "package:mac:arm64": "npm run build && pnpm run rebuild:electron -- -a arm64 && electron-builder --mac dmg --arm64 --config.npmRebuild=false",
    "package:mac:x64": "npm run build && pnpm run rebuild:electron -- -a x64 && electron-builder --mac dmg --x64 --config.npmRebuild=false",
    "package:win": "npm run build && pnpm run rebuild:electron -- -a x64 && electron-builder --win nsis --x64 --config.npmRebuild=false"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.0",
    "@capacitor/splash-screen": "8.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^12.4.1",
    "electron-store": "^11.0.2",
    "i18next": "^25.6.0",
    "lucide-react": "^0.552.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.3.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.certmasterai.desktop",
    "productName": "CertMaster AI",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.test.js",
      "question-banks/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "CertMaster-AI-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "CertMaster-AI-${version}-win-${arch}-setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
